{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "description": "One venture in JS, Founder Mode. One file per project in src/content/projects/, named <slug>.json.",
  "type": "object",
  "definitions": {
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "yyyy-mm-dd" }
  },
  "required": [
    "slug",
    "name",
    "oneLiner",
    "stage",
    "category",
    "startedOn",
    "problem",
    "workflow",
    "stack",
    "milestones",
    "journey"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The URL: /v/<slug>. Must match the file name. Never change it once published."
    },
    "name": { "type": "string" },
    "oneLiner": { "type": "string", "description": "Shown in the table and the journey hero." },
    "stage": { "enum": ["idea", "building", "beta", "live", "paused"] },
    "category": { "type": "string", "description": "e.g. AI tooling, Productivity, Consumer" },
    "startedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}$", "description": "yyyy-mm" },
    "lastUpdated": {
      "$ref": "#/definitions/day",
      "description": "Optional. Derived from the newest journey entry when omitted."
    },
    "nextMilestone": { "type": "string", "description": "Short text for the table." },
    "role": { "type": "string", "description": "e.g. Solo founder, Co-founder & CTO" },
    "liveUrl": { "type": "string", "format": "uri" },
    "links": { "type": "array", "items": { "$ref": "#/definitions/link" } },
    "problem": {
      "type": "string",
      "description": "Why this exists. Separate paragraphs with a blank line (\\n\\n)."
    },
    "audience": { "type": "string", "description": "Who it's for." },
    "workflow": {
      "type": "array",
      "description": "How it works, in order.",
      "items": {
        "type": "object",
        "required": ["title", "detail"],
        "properties": { "title": { "type": "string" }, "detail": { "type": "string" } },
        "additionalProperties": false
      }
    },
    "stack": { "type": "array", "items": { "type": "string" } },
    "architectureNote": { "type": "string" },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "state"],
        "properties": {
          "label": { "type": "string" },
          "state": { "enum": ["done", "doing", "next"] },
          "date": { "$ref": "#/definitions/day" }
        },
        "additionalProperties": false
      }
    },
    "journey": {
      "type": "array",
      "description": "The log. Any order; the page sorts newest first.",
      "items": {
        "type": "object",
        "required": ["date", "title", "body", "kind"],
        "properties": {
          "date": { "$ref": "#/definitions/day" },
          "title": { "type": "string" },
          "body": {
            "type": "string",
            "description": "Separate paragraphs with a blank line (\\n\\n)."
          },
          "kind": { "enum": ["shipped", "decision", "learning", "milestone", "setback"] },
          "links": { "type": "array", "items": { "$ref": "#/definitions/link" } }
        },
        "additionalProperties": false
      }
    },
    "roadmap": { "type": "array", "items": { "type": "string" } },
    "metrics": {
      "type": "array",
      "description": "Only real numbers.",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": { "label": { "type": "string" }, "value": { "type": "string" } },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
